# Configuración local del backend. Copiar a server/.env (que NUNCA se commitea):
#   cp server/.env.example server/.env
# Los valores de abajo son de ejemplo, solo para desarrollo local.

# Conexión desde el host (servidor con `npm run dev` y Prisma CLI)
DATABASE_URL=postgresql://cuantoes:cuantoes@localhost:5432/cuantoes

# Conexión desde el contenedor `api` (host `db` de docker compose)
DOCKER_DATABASE_URL=postgresql://cuantoes:cuantoes@db:5432/cuantoes

# Base separada para los tests (la crea server/docker/init-test-db.sql)
TEST_DATABASE_URL=postgresql://cuantoes:cuantoes@localhost:5432/cuantoes_test

# Secreto para firmar los JWT: mínimo 32 caracteres aleatorios. Para generarlo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Puerto de la API
PORT=3001

# Costo de bcrypt (12 en desarrollo; los tests usan 4)
BCRYPT_ROUNDS=12

# Inicialización del contenedor `db` (postgres:16)
POSTGRES_USER=cuantoes
POSTGRES_PASSWORD=cuantoes
POSTGRES_DB=cuantoes
